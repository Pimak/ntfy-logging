<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.pimak</groupId>
    <artifactId>ntfy-logging</artifactId>
    <version>2.1.0</version>
    <packaging>pom</packaging>

    <name>ntfy-logging</name>
    <description>Zero-dependency ntfy notification engine plus logging-framework adapters that publish ERROR-level log events as ntfy push notifications.</description>

    <modules>
        <!-- The framework-neutral engine every adapter builds on. -->
        <module>ntfy-core</module>
        <!-- java.util.logging handler + zero-code auto-handler/installer; also the handler the Quarkus extension installs. -->
        <module>ntfy-jul</module>
        <!-- Logback appender + zero-code auto-install (Configurator SPI); serves Spring and any Logback app. -->
        <module>ntfy-logback</module>
        <!-- Log4j2 appender (declarative <Ntfy> element) + a one-line programmatic installer. -->
        <module>ntfy-log4j2</module>
        <!-- Spring Boot auto-configuration over whichever backend is on the classpath (Logback or Log4j2) + an injectable NtfyClient bean. -->
        <module>ntfy-spring-boot-starter</module>
        <!-- Quarkus extension aggregator (runtime + deployment) on top of ntfy-jul; native + zero-code via LogHandlerBuildItem. -->
        <module>ntfy-quarkus</module>
        <!-- Micronaut integration on top of ntfy-logback: binds ntfy.* from application.yml and exposes an injectable NtfyClient. -->
        <module>ntfy-micronaut</module>
        <!--
            Bill of materials over the seven user-facing artifacts. Last in this list, not first:
            it is the only module whose content is a statement ABOUT the others, so it reads in
            the right order once they have been introduced.
        -->
        <module>ntfy-bom</module>
        <!--
            Runnable example applications that double as functional test-beds — one per adapter,
            plus the shared loopback ntfy stand-in their tests use. NEVER published (each module
            sets the full skip block; the release profile's excludeArtifacts below is the
            authoritative Central exclusion). In the reactor so plain `verify` keeps every example
            compiling and its integration tests green: the examples cannot drift from the code.
        -->
        <module>examples/testkit</module>
        <module>examples/core</module>
        <module>examples/jul</module>
        <module>examples/logback</module>
        <module>examples/logback-zero-code</module>
        <module>examples/log4j2</module>
        <module>examples/micronaut</module>
        <module>examples/spring-boot</module>
    </modules>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <url>https://github.com/Pimak/ntfy-logging</url>
    <scm>
        <connection>scm:git:https://github.com/Pimak/ntfy-logging.git</connection>
        <developerConnection>scm:git:https://github.com/Pimak/ntfy-logging.git</developerConnection>
        <url>https://github.com/Pimak/ntfy-logging</url>
    </scm>

    <developers>
        <developer>
            <id>pimak</id>
            <name>pimak</name>
            <!-- GitHub noreply address — keeps a personal email off public metadata (Central requires a contactable developer). -->
            <email>37274338+Pimak@users.noreply.github.com</email>
            <url>https://github.com/pimak</url>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <!--
            Reproducible builds. Every archiver in the reactor (jar, source-jar, javadoc-jar) writes
            this instant into its zip entries instead of the wall clock, so rebuilding a tag from
            clean sources produces byte-identical artifacts — which is what lets a third party check
            that the jar on Central was really built from the tag it claims. It generalises to the
            whole reactor what <notimestamp> in the javadoc profile already does for one plugin.

            The value is the RELEASE DATE, and release.sh rewrites it from the same ${TODAY} that
            stamps the CHANGELOG section, in the same commit as the version bump. Left to drift it
            would still reproduce — every rebuild would agree — while claiming a build date that is
            not the release's, so ReproducibleBuildGuardTest holds it against the CHANGELOG's newest
            dated heading and fails when the two part ways.

            Maven silently IGNORES a value it cannot parse, which would drop reproducibility without
            failing anything; the same guard parses it here so that cannot pass unnoticed.
        -->
        <project.build.outputTimestamp>2026-08-26T00:00:00Z</project.build.outputTimestamp>
        <logback.version>1.6.3</logback.version>
        <!--
            Latest stable of the maintained Log4j 2.x line (3.x is still 3.0.0-beta*). Consumed
            provided-scope by ntfy-log4j2, so this pin only fixes what the adapter COMPILES
            against — the host application's own log4j2 version is what runs.
        -->
        <log4j2.version>2.26.1</log4j2.version>
        <slf4j.version>2.0.18</slf4j.version>
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <wiremock.version>3.13.2</wiremock.version>
        <quarkus.version>3.38.3</quarkus.version>
        <spring-boot.version>4.1.1</spring-boot.version>
        <!--
            Micronaut platform BOM. Like the Spring Boot BOM, it is imported by the module that
            needs it rather than here, so its managed versions cannot collide with the Quarkus BOM
            imported below; this property just keeps the version pinned in one visible place.

            Held at the 4.10.x line ON PURPOSE, and this is a CI constraint rather than a
            compatibility one. Micronaut 5 ships Java 25 bytecode (class file version 69) in
            micronaut-inject and micronaut-core, and in the micronaut-inject-java annotation
            processor, so a build running on JDK 21 dies loading the processor
            ("MixinVisitorProcessor has been compiled by a more recent version of the Java
            Runtime"). Micronaut 4.10.x is Java 17 bytecode and builds on both JDKs the CI matrix
            uses (21 and 25); moving this pin to 5.x would break the 21 leg, which exists to keep
            proving maven.compiler.release above.

            It does NOT mean Micronaut 5 is unsupported. On JDK 25 the module builds and its whole
            suite passes against 5.x unchanged, and the jar published from this 4.x line is read by
            Micronaut 5 as-is. Both facts are measured weekly by .github/workflows/compat.yml — the
            5.x sweep row and the forward-compat job — and written up in docs/compatibility.md.
            An application on Micronaut 5 simply overrides this property.
        -->
        <micronaut.version>4.10.17</micronaut.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Centralized versions for logging-framework and test dependencies used across modules. -->
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-core</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <!--
                Log4j2 API + core for the ntfy-log4j2 adapter. Declared as two explicit
                coordinates rather than importing log4j-bom: the reactor already imports the
                Quarkus platform BOM here and the comment below explains why BOM imports are kept
                as narrow as possible — two artifacts do not justify a third platform import.
                Everything else log4j-core declares is either optional or provided, so nothing
                else reaches the adapter's classpath.
            -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>

            <!--
                Quarkus platform BOM for the Quarkus extension modules (runtime + deployment),
                which parent this root pom directly. Harmless to ntfy-core/ntfy-logback (they
                declare no Quarkus dependency; a BOM import alone adds nothing to a module).
                NOTE: the Spring Boot BOM is deliberately NOT imported here — it is scoped to the
                ntfy-spring-boot-starter module's own dependencyManagement instead. Importing both
                platform BOMs at the parent made every module's effective model resolve hundreds of
                overlapping managed-version conflicts (byte-buddy, etc.); keeping each BOM local to
                the module that needs it removes that cross-contamination.
            -->
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <release>21</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                    <configuration>
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.6</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.6.3</version>
                    <!--
                        Version is managed here so every module inherits it, but the concrete
                        bannedDependencies ALLOWLIST execution lives in each module's own pom:
                        the allowlist is per-module (ntfy-core is pure JDK + its test stack; the
                        logback adapter additionally allows logback/slf4j, etc.), so it cannot be a
                        single inherited execution. See each module pom for its allowlist and the
                        explanatory comment that travels with it.
                    -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-artifact-plugin</artifactId>
                    <version>3.6.0</version>
                    <!--
                        Version only — no execution, here or anywhere. The plugin's check-buildplan
                        goal is invoked by its prefix from the `reproducible` CI job, which picks
                        the version up from this block; binding it to a phase would put the check
                        in every local build for a property that can only change at release time.

                        Pinned here rather than spelled out in the workflow so Dependabot sees it:
                        the goal's own rule set is what knows which plugin versions are
                        reproducible, so a stale pin makes the gate quietly weaker over time.
                    -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>3.28.0</version>
                    <executions>
                        <execution>
                            <id>dead-code-guard</id>
                            <!-- default phase = verify, no override needed -->
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <rulesets>
                            <!-- Each module keeps a copy of the shared dead-code ruleset at its own
                                 basedir; resolution is module-relative just as in the original single
                                 module build. -->
                            <ruleset>${project.basedir}/pmd-ruleset.xml</ruleset>
                        </rulesets>
                        <failOnViolation>true</failOnViolation>
                        <linkXRef>false</linkXRef>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.github.siom79.japicmp</groupId>
                    <artifactId>japicmp-maven-plugin</artifactId>
                    <version>0.26.1</version>
                    <!--
                        The API guard. Until now the ONLY thing standing between a refactor and a
                        broken downstream build was prose in three tests (AlertEventLevelTest,
                        AlertEventMdcTest, NtfyJulHandlerTest) that each pin one legacy constructor
                        — and the release profile publishes with autoPublish=true, so a break
                        reaches consumers on an immutable coordinate before anyone can look at it.
                        This compares each published module's freshly built jar against that same
                        module's own last release on Central.

                        BASELINE. japicmp resolves the old side itself from the version range
                        (,${project.version}) — the greatest RELEASED version strictly below the
                        version being built. That range is not a choice: it is hardcoded in the mojo
                        as versionRangeWithProjectVersion with editable=false. Configuring an
                        explicit <oldVersion> is no way around it either — that code path hands the
                        version string to a plain Aether ArtifactRequest, which wants a concrete
                        version and cannot resolve a range at all. What makes the built-in range
                        correct HERE is that this repo never carries -SNAPSHOT versions: the pom
                        sits at the last released version until release.sh bumps it, so "strictly
                        below the pom version" is always "the previous release" — on a feature
                        branch and on the release tag alike.

                        The tree is at 2.0.0 and 2.0.0 is already on Central, so the baseline right
                        now is the 1.x line (1.2.0): a major bump, where breaks are legitimate. For
                        artifacts first published in 2.0.0 the range resolves to nothing at all.
                        Both are expected states of a just-released tree, not bugs.

                        REPORT ONLY HERE. No breakBuild* flag is set, so `verify` writes
                        target/japicmp/*.{html,xml,diff} and stays green whatever it finds. The
                        gate is armed from exactly one place: release.yml passes
                        -Djapicmp.breakBuildBasedOnSemanticVersioning=true in a blocking step
                        ahead of the Central deploy. ci.yml deliberately does not — a check that
                        can go red because somebody else cut a release, or because Central was
                        slow, has no business being a required check on a PR.

                        SEMVER MODE rather than a flat "never break binary compatibility" is what
                        keeps a major release shippable: the gate weighs the API delta against the
                        version delta, so dropping a method under 2.0.0 -> 2.1.0 fails while the
                        same drop under 2.0.0 -> 3.0.0 passes. A deliberate break needs no
                        override — it needs the major bump it already deserved.

                        Version is managed here; each PUBLISHED module activates it with a bare
                        <plugin> declaration of its own, exactly as with pmd and enforcer above.
                        That is also what keeps examples/* out: they are never published, so they
                        simply never declare it — no exclude list to keep in sync.
                    -->
                    <executions>
                        <execution>
                            <id>api-compatibility</id>
                            <!-- default phase = verify, no override needed -->
                            <goals>
                                <goal>cmp</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <parameter>
                            <!-- Report the API delta, not the whole API surface: without this every
                                 unchanged class is listed too and the report is unreadable. -->
                            <onlyModified>true</onlyModified>
                        </parameter>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
            Release-only machinery. Never activated by plain `verify` (CI's default), so day-to-day
            builds are untouched. Activate with `-P release` to assemble + sign the Central bundle.
            Applied per-module across the reactor. Goal-binding order is deliberate (RESEARCH Pitfall 3):
              package -> sources jar + javadoc jar (both must exist first)
              verify  -> gpg:sign (signs the main + sources + javadoc jars once they are present)
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <!-- 3.4.0 stable; 4.0.0-beta-* deliberately avoided (RESEARCH: no betas in the release path). -->
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <!-- package: the sources jar must exist before gpg:sign runs at verify. -->
                                <phase>package</phase>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <!-- package: the javadoc jar must exist before gpg:sign runs at verify. -->
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- Build javadoc against the JDK 21 source level (compiler floor). JDK 25's doclint is
                                 stricter; pinning the source level keeps the release javadoc reproducible. -->
                            <source>21</source>
                            <!-- Tuned by the local dry run (Task 2). all,-missing = enforce well-formed doc but
                                 don't fail on absent tags. -->
                            <doclint>all,-missing</doclint>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <!-- verify: sign only after main + sources + javadoc jars all exist. -->
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <!-- Passphrase is read from the MAVEN_GPG_PASSPHRASE env var, never an
                                         inline passphrase config element (deprecated in 3.2.x and leaks to logs).
                                         loopback pinentry allows unattended signing in CI. -->
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <!-- extensions=true wires this plugin in as the deploy handler for the Central Portal.
                             Scoped to the release profile (NOT the main build) so the -P github-mirror leg's
                             `deploy` is handled by maven-deploy-plugin, keeping the two legs structurally
                             separate (D-12). NOTE: the deploy MUST run under Maven 3.9 — this plugin (0.11.0,
                             latest as of this pin) does not upload under Maven 4 (it stages the bundle locally and the
                             session upload hook never fires, producing a green-but-unpublished build). This is
                             why ./mvnw pins the 3.9.x line for the whole project rather than only for release:
                             see .mvn/wrapper/maven-wrapper.properties, and the version gate in release.yml. -->
                        <extensions>true</extensions>
                        <configuration>
                            <!-- Server credentials (Central Portal user token) resolved from settings.xml <server id="central">. -->
                            <publishingServerId>central</publishingServerId>
                            <!-- D-01: a validation-passing bundle is published automatically on upload — no manual dashboard click. -->
                            <autoPublish>true</autoPublish>
                            <!-- Block the build until the deployment is actually PUBLISHED, so a validation
                                 failure turns CI red instead of leaving a green-but-unpublished false positive. -->
                            <waitUntil>published</waitUntil>
                            <!-- Keep the Quarkus native smoke app out of the Central bundle. The plugin
                                 filters the aggregate bundle by artifactId (PublishMojo matches
                                 excludeArtifacts.contains(artifact.getArtifactId())), so the plain
                                 artifactId is the exact, verified match. This is the AUTHORITATIVE
                                 exclusion — safer than per-module skipPublishing, which (deferred/aggregate
                                 upload) could skip the whole upload if the excluded module triggers it.
                                 The integration-tests module ALSO sets maven.deploy.skip/source/javadoc/gpg
                                 skips in its own pom as defense in depth. -->
                            <excludeArtifacts>
                                <excludeArtifact>ntfy-quarkus-integration-tests</excludeArtifact>
                                <excludeArtifact>ntfy-example-testkit</excludeArtifact>
                                <excludeArtifact>ntfy-example-core</excludeArtifact>
                                <excludeArtifact>ntfy-example-jul</excludeArtifact>
                                <excludeArtifact>ntfy-example-logback</excludeArtifact>
                                <excludeArtifact>ntfy-example-logback-zero-code</excludeArtifact>
                                <excludeArtifact>ntfy-example-log4j2</excludeArtifact>
                                <excludeArtifact>ntfy-example-micronaut</excludeArtifact>
                                <excludeArtifact>ntfy-example-spring-boot</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            D-12: the GitHub Packages mirror is a STRUCTURALLY SEPARATE leg — classic distributionManagement
            + maven-deploy-plugin, never mixed into the Central Portal plugin's path. Activate with
            `-P github-mirror` and run `deploy`. This leg is best-effort (D-11) and is not advertised as a
            consumer install path (D-13).
        -->
        <profile>
            <id>github-mirror</id>
            <distributionManagement>
                <repository>
                    <id>github</id>
                    <name>GitHub Packages</name>
                    <url>https://maven.pkg.github.com/Pimak/ntfy-logging</url>
                </repository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <!-- 3.1.4 stable; 4.0.0-beta-* deliberately avoided. -->
                        <version>3.1.4</version>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Aggregated Javadoc for the documentation site, published by .github/workflows/docs.yml.
            Never activated by plain `verify`, like the release profile above. It does NOT replace
            that profile's per-module javadoc:jar, which Central requires — it changes only which
            Javadoc the project advertises.
        -->
        <profile>
            <id>docs-site</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <!-- Same version and settings as the release profile: one Javadoc toolchain. -->
                        <version>3.12.0</version>
                        <configuration>
                            <source>21</source>
                            <doclint>all,-missing</doclint>
                            <!--
                                Both of these keep the gh-pages branch from growing without bound.
                                `dev` is redeployed on every push to main, and git never reclaims
                                blobs from past commits, so any per-run difference is committed
                                forever: javadoc otherwise stamps a generation date into every page,
                                and derives a copyright year that turns over on 1 January (and that
                                the 4.x line renders as 1980 outright). Pinning both makes unchanged
                                sources produce byte-identical output on any date and any Maven line.
                            -->
                            <notimestamp>true</notimestamp>
                            <bottom><![CDATA[Copyright &#169; pimak. Licensed under the <a href="https://www.apache.org/licenses/LICENSE-2.0.txt">Apache License, Version 2.0</a>.]]></bottom>
                            <!-- Consumer API only. A single comma-separated String, not nested elements. -->
                            <skippedModules>ntfy-example-testkit,ntfy-example-core,ntfy-example-jul,ntfy-example-logback,ntfy-example-log4j2,ntfy-example-micronaut,ntfy-example-spring-boot,ntfy-quarkus-integration-tests,ntfy-quarkus-deployment</skippedModules>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
