<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.pimak</groupId>
        <artifactId>ntfy-logging</artifactId>
        <version>2.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ntfy-example-core</artifactId>
    <packaging>jar</packaging>

    <name>ntfy-example-core</name>
    <description>
        Runnable example for ntfy-core that doubles as its functional test-bed: a plain-JVM app
        driving NtfyClient (manual notifications) and AlertEngine (error alerting) directly. The
        integration tests run the example code against a loopback ntfy stand-in and prove the base
        publish path, the synchronous-vs-asynchronous delivery difference, and the clean-shutdown
        digest flush. This module is NEVER published to Central.
    </description>

    <properties>
        <!-- Example/test harness, not a released artifact: keep it out of every publish and
             static-analysis path that the released modules run. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <gpg.skip>true</gpg.skip>
        <enforcer.skip>true</enforcer.skip>
        <pmd.skip>true</pmd.skip>
        <cpd.skip>true</cpd.skip>
    </properties>

    <dependencies>
        <!-- The library under example — exactly what a consumer of the programmatic API declares. -->
        <dependency>
            <groupId>io.github.pimak</groupId>
            <artifactId>ntfy-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.pimak</groupId>
            <artifactId>ntfy-example-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The *IT integration tests run at verify; version + executions inherited from the
                 parent's pluginManagement — declaring the plugin activates them. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- CoreNativeBinaryIT drives a binary that only the `native` profile below
                         builds, so the default (JVM) build must not run it. Excluding it by TAG
                         rather than letting it skip itself on a missing binary is deliberate: under
                         the profile, an absent binary has to fail the build, and a test that decides
                         for itself whether it applies is exactly the silent green this module's
                         native leg exists to rule out. -->
                    <excludedGroups>native-binary</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Native leg. Activated by `-Dnative`, the same property the Quarkus integration-tests
            module uses, so one flag drives every native leg in the reactor. It compiles
            CoreNativeProbe into a binary and lets CoreNativeBinaryIT drive it against a loopback
            ntfy stand-in — the hand-rolled (non-Quarkus) native path that docs/compatibility.md
            ships metadata for. Runs in the existing CI `native-smoke` job; never a job of its own.
        -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>1.1.10</version>
                        <executions>
                            <execution>
                                <id>build-native-probe</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>ntfy-core-native-probe</imageName>
                            <mainClass>com.example.ntfycore.CoreNativeProbe</mainClass>
                            <!-- A fallback image is a JVM launcher wearing a binary's name: it runs,
                                 the IT passes, and nothing about native reachability was tested.
                                 Refusing it is what makes a missing registration a build failure. -->
                            <fallback>false</fallback>
                            <!-- Only the metadata our own jars carry may satisfy this build. The
                                 shared reachability-metadata repository could supply a registration
                                 we failed to ship and hide the very gap this leg looks for. -->
                            <metadataRepository>
                                <enabled>false</enabled>
                            </metadataRepository>
                            <!-- -Ob: cuts image build time roughly in half. It lowers the optimizer,
                                 not the reachability analysis, so what this leg measures is
                                 unaffected. -->
                            <quickBuild>true</quickBuild>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <!-- Nothing excluded here: the JVM ITs and the native one both run. -->
                            <excludedGroups combine.self="override"/>
                            <systemPropertyVariables>
                                <ntfy.native.probe>${project.build.directory}/ntfy-core-native-probe</ntfy.native.probe>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
