<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.pimak</groupId>
        <artifactId>ntfy-logging</artifactId>
        <version>2.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ntfy-example-logback-zero-code</artifactId>
    <packaging>jar</packaging>

    <name>ntfy-example-logback-zero-code</name>
    <description>
        The zero-code Logback path, on its own: ntfy-logback on the classpath, NO logback.xml
        anywhere, and the appender installed by the Configurator SPI alone. That absence is the
        module — examples/logback wires the appender explicitly in XML, which exercises Joran rather
        than the SPI, and an XML-configured appender publishing alongside would make it impossible to
        tell which of the two reached the wire. Here the only appender that can publish is the one
        the SPI installed. The integration tests run the probe twice over: in the JVM, and (under
        -Dnative) as a GraalVM binary, which is what measures whether the service lookup behind the
        zero-code promise survives image build. This module is NEVER published to Central.
    </description>

    <properties>
        <!-- Example/test harness, not a released artifact: keep it out of every publish and
             static-analysis path that the released modules run. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <gpg.skip>true</gpg.skip>
        <enforcer.skip>true</enforcer.skip>
        <pmd.skip>true</pmd.skip>
        <cpd.skip>true</cpd.skip>
    </properties>

    <dependencies>
        <!-- Exactly what a zero-code consumer declares: the adapter, the SLF4J API, and a Logback
             backend. Nothing names ntfy in code or in configuration. -->
        <dependency>
            <groupId>io.github.pimak</groupId>
            <artifactId>ntfy-logback</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.pimak</groupId>
            <artifactId>ntfy-example-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The *IT integration tests run at verify; version + executions inherited from the
                 parent's pluginManagement — declaring the plugin activates them. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- Same rule as examples/core: the binary only exists under the `native`
                         profile, and an absent binary must fail there rather than skip green. -->
                    <excludedGroups>native-binary</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Native leg, activated by `-Dnative` like every other native leg in the reactor. Logback
            itself ships NO native-image metadata (checked: neither logback-classic nor logback-core
            carries a META-INF/native-image directory), which is precisely why this probe must have
            no logback.xml: an image that ran Joran would need reflection metadata for every appender
            and encoder in that file and would fail for reasons that say nothing about the SPI.
        -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>1.1.10</version>
                        <executions>
                            <execution>
                                <id>build-native-probe</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>ntfy-logback-zero-code-probe</imageName>
                            <mainClass>com.example.ntfyzerocode.ZeroCodeNativeProbe</mainClass>
                            <!-- A fallback image would run the SPI on a JVM and pass while proving
                                 nothing about the image. -->
                            <fallback>false</fallback>
                            <!-- Only metadata these jars actually ship may satisfy the build: the
                                 open question is whether ntfy-logback needs some, and borrowing a
                                 registration from the shared repository would answer it wrongly. -->
                            <metadataRepository>
                                <enabled>false</enabled>
                            </metadataRepository>
                            <quickBuild>true</quickBuild>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <!-- Both legs run: the JVM control and the native one it controls for. -->
                            <excludedGroups combine.self="override"/>
                            <systemPropertyVariables>
                                <ntfy.native.probe>${project.build.directory}/ntfy-logback-zero-code-probe</ntfy.native.probe>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
