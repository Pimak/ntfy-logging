<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.pimak</groupId>
        <artifactId>ntfy-logging</artifactId>
        <version>1.2.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ntfy-example-log4j2</artifactId>
    <packaging>jar</packaging>

    <name>ntfy-example-log4j2</name>
    <description>
        Runnable example for ntfy-log4j2 that doubles as its functional test-bed: a plain Log4j2
        application whose log4j2.xml declares the &lt;Ntfy&gt; appender element. The integration tests
        build a LoggerContext from that very log4j2.xml against a loopback ntfy stand-in and prove the
        base alert path, the synchronous-vs-asynchronous delivery difference, and the clean-shutdown
        digest flush. This module is NEVER published to Central.
    </description>

    <properties>
        <!-- Example/test harness, not a released artifact: keep it out of every publish and
             static-analysis path that the released modules run. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <gpg.skip>true</gpg.skip>
        <enforcer.skip>true</enforcer.skip>
        <pmd.skip>true</pmd.skip>
        <cpd.skip>true</cpd.skip>
    </properties>

    <dependencies>
        <!-- The library under example — exactly what a Log4j2 consumer declares (it pulls
             ntfy-core transitively, and carries the Log4j2Plugins.dat descriptor that makes the
             <Ntfy> element resolve). -->
        <dependency>
            <groupId>io.github.pimak</groupId>
            <artifactId>ntfy-log4j2</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The app logs through the Log4j2 API with log4j-core as the backend, like any Log4j2
             app. Compile scope, NOT provided: the adapter keeps log4j2 provided because the host
             application supplies it — here this module IS that host application. Versions come
             from the parent's dependencyManagement. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.pimak</groupId>
            <artifactId>ntfy-example-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The *IT integration tests run at verify; version + executions inherited from the
                 parent's pluginManagement — declaring the plugin activates them. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
