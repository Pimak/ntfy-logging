<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.pimak</groupId>
        <artifactId>ntfy-logging</artifactId>
        <version>1.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ntfy-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>ntfy-spring-boot-starter</name>
    <description>Spring Boot auto-configuration starter that installs the ntfy Logback appender on the root logger from ntfy.* properties and exposes an injectable NtfyClient bean.</description>

    <dependencyManagement>
        <dependencies>
            <!--
                Spring Boot BOM scoped to this module (not the reactor parent) so its managed
                versions never collide with the Quarkus BOM in the other adapter modules.
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            The framework-neutral engine (NtfyClient / NtfyConfig) and the Logback adapter
            (LogbackAlertAppender) this starter wires into a Spring Boot application. Versions of
            these two come from the reactor parent; the Spring Boot dependencies below come from the
            spring-boot-dependencies BOM imported by the parent.
        -->
        <dependency>
            <groupId>io.github.pimak</groupId>
            <artifactId>ntfy-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.pimak</groupId>
            <artifactId>ntfy-logback</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            The Log4j2 adapter, for applications built on spring-boot-starter-log4j2. Marked
            optional so it is not forced onto the overwhelmingly common Logback consumer: a Log4j2
            application declares io.github.pimak:ntfy-log4j2 explicitly alongside this starter.
            ntfy-logback above is deliberately NOT optional — it is exported transitively today and
            making it optional would break anyone who references LogbackAlertAppender directly or
            names it in a logback.xml. Keeping it costs a Log4j2 application nothing at runtime:
            its own logback dependencies are provided-scope, so it cannot drag Logback onto the
            classpath, and its Configurator service file is only ever read by Logback.
            Optionality only affects downstream resolution — the dependency stays on this module's
            own compile AND test classpath, so no separate test-scope declaration is needed.
        -->
        <dependency>
            <groupId>io.github.pimak</groupId>
            <artifactId>ntfy-log4j2</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>

        <!--
            Logback is provided-scope: every Spring Boot application already ships logback-classic
            via spring-boot-starter-logging, so this starter compiles against it without forcing a
            (possibly conflicting) version onto the consumer classpath.
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Log4j2 is provided-scope for the same reason as Logback above: a spring-boot-starter-log4j2
            application already ships log4j-core, and Log4j2NtfyBackend only needs to compile against
            its LoggerContext/Configuration API. Version comes from the reactor parent.
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Optional Micrometer binding: when the consumer already has micrometer-core on the
            classpath (any Spring Boot Actuator app does), the starter exports the ntfy pipeline
            counters as meters. Marked optional so it is never forced onto consumers who do not want
            metrics; the Micrometer wiring is guarded by @ConditionalOnClass(MeterRegistry.class).
            Optionality only affects downstream resolution — the dependency stays on this module's
            own compile AND test classpath, so no separate test-scope declaration is needed. Version
            comes from the imported spring-boot-dependencies BOM.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            The reader half of the configuration-metadata format (the same parser IDEs use), so
            NtfyConfigurationMetadataTest can assert against the metadata this module actually
            generates rather than re-implementing a JSON reader. Test-only: nothing at runtime
            reads metadata. Version comes from the imported spring-boot-dependencies BOM.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-metadata</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        spring-boot-configuration-processor turns the @ConfigurationProperties
                        class into META-INF/spring-configuration-metadata.json — the file IDEs read
                        to complete and describe the ntfy.* keys. It is declared here rather than
                        as an optional dependency (the usual Spring idiom) for the same reason
                        ntfy-log4j2 declares log4j-core's processor this way: javac stopped
                        scanning the classpath for annotation processors by default in JDK 23, and
                        CI builds this reactor on both JDK 21 and JDK 25. Left to classpath
                        discovery the metadata simply stopped being generated on the newer JDK, and
                        nothing said so — a missing metadata file breaks no compilation. An
                        explicit processor path makes the generation JDK-independent, and
                        NtfyConfigurationMetadataTest now fails loudly if it ever stops running.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring-boot.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <!--
                Enforcer bannedDependencies (the strict per-module allowlist used by ntfy-core and
                ntfy-logback) is deliberately NOT wired in here: a Spring Boot starter pulls in a
                large, legitimate transitive tree (spring-context, spring-core, jackson, ...) that an
                allowlist cannot usefully enumerate. PMD dead-code check is likewise skipped for this
                module to avoid false positives on framework-shaped code.
            -->
        </plugins>
    </build>
</project>
