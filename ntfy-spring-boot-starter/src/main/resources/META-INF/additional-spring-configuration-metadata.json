{
  "properties": [
    {
      "name": "ntfy.connect-timeout",
      "type": "java.time.Duration",
      "defaultValue": "5s"
    },
    {
      "name": "ntfy.request-timeout",
      "type": "java.time.Duration",
      "defaultValue": "10s"
    },
    {
      "name": "ntfy.suppression-window",
      "type": "java.time.Duration",
      "defaultValue": "3m"
    }
  ],
  "hints": [
    {
      "name": "ntfy.error-priority",
      "values": [
        { "value": "min" },
        { "value": "low" },
        { "value": "default" },
        { "value": "high" },
        { "value": "urgent" }
      ]
    },
    {
      "name": "ntfy.digest-priority",
      "values": [
        { "value": "min" },
        { "value": "low" },
        { "value": "default" },
        { "value": "high" },
        { "value": "urgent" }
      ]
    },
    {
      "name": "ntfy.locale",
      "values": [
        { "value": "en", "description": "English (the built-in default)." },
        { "value": "fr", "description": "French." }
      ]
    },
    {
      "name": "ntfy.excluded-loggers",
      "providers": [
        { "name": "logger-name" }
      ]
    }
  ]
}
