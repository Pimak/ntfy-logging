<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.pimak</groupId>
        <artifactId>ntfy-logging</artifactId>
        <version>1.2.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ntfy-quarkus-runtime</artifactId>
    <packaging>jar</packaging>

    <name>ntfy-quarkus-runtime</name>
    <description>
        Runtime half of the ntfy Quarkus extension: the run-time @ConfigMapping, the recorder
        that builds ntfy-jul's java.util.logging Handler at RUNTIME_INIT, and a CDI producer
        exposing a generic NtfyClient. This is the artifact applications depend on.
    </description>

    <dependencies>
        <!-- The framework-neutral JUL handler this extension installs (NtfyJulHandler), which
             brings the ntfy-core engine/client transitively. Every alert path calls into these. -->
        <dependency>
            <groupId>io.github.pimak</groupId>
            <artifactId>ntfy-jul</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- quarkus-core: @Recorder, RuntimeValue, @ConfigRoot/@ConfigPhase; version managed by quarkus-bom. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-core</artifactId>
        </dependency>
        <!-- quarkus-arc: CDI (jakarta.enterprise/inject annotations) for the NtfyClient producer. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>

        <!-- Test stack: plain JUnit + AssertJ. The reliable-path unit tests live here (a loopback
             com.sun.net.httpserver.HttpServer stands in for ntfy, no WireMock needed). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- The Quarkus extension annotation processor generates the build-time
                         metadata this extension needs: notably META-INF/quarkus-config-roots.list
                         (so the @ConfigRoot @ConfigMapping run-time config is discovered) and the
                         extension bytecode-recording glue. Required for a well-formed 3.37 extension. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.quarkus</groupId>
                            <artifactId>quarkus-extension-processor</artifactId>
                            <version>${quarkus.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
                The Quarkus counterpart of the Spring starter's configuration metadata. The
                annotation processor above already emits the config model and the @ConfigMapping
                javadoc — as META-INF/quarkus-config-doc/*.json inside the jar, where Quarkus'
                own tooling reads it — and it is strict about that javadoc: a config method
                without one fails the compilation outright ("Unable to find javadoc for config
                item"), which is why the quarkus.ntfy.* keys need no completeness test of their
                own, unlike the Spring ones.

                What this plugin adds is the readable rendering of that model: a Markdown table of
                every quarkus.ntfy.* key with its type, default and environment-variable name,
                regenerated on demand with
                `./mvnw -pl ntfy-quarkus/runtime -am process-classes`. It stays in target/ and is
                never committed — docs/configuration.md remains the single cross-surface key
                reference, and a committed copy would be one more thing to keep in step with it.

                Bound to process-classes, not the goal's default generate-resources: the model it
                reads is written by the annotation processor during compile, so on a clean build
                the default binding would find nothing to render.
            -->
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-config-doc-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <executions>
                    <execution>
                        <id>generate-config-doc</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>generate-config-doc</goal>
                        </goals>
                        <configuration>
                            <!-- Markdown to match the docs/ tree, rather than the Quarkus-site asciidoc default. -->
                            <format>markdown</format>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!-- Generates META-INF/quarkus-extension.properties, binding this runtime artifact to
                 its deployment artifact so Quarkus knows which processor to load at build time. -->
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-extension-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <executions>
                    <execution>
                        <id>generate-extension-descriptor</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>extension-descriptor</goal>
                        </goals>
                        <configuration>
                            <deployment>io.github.pimak:ntfy-quarkus-deployment:${project.version}</deployment>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
