<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuration for the JVM-global LoggerContext during this module's test run, and nothing else.

    The example's real log4j2.xml sits in src/main/resources, i.e. on the test classpath too, so
    log4j2 would auto-detect it the moment anything in the test JVM touched LogManager — silently
    starting a SECOND ntfy alert engine (with its always-on ntfy-alert-digest daemon) aimed at the
    placeholder https://ntfy.example.com. That stray engine would make the clean-shutdown IT's
    "no engine thread survives" assertion fail for a reason that has nothing to do with the code
    under test. log4j2 prefers log4j2-test.xml over log4j2.xml, so this ntfy-free file wins.

    The ITs are unaffected: they load the example's log4j2.xml explicitly, by URL, into their own
    isolated LoggerContext (see ExampleLoggerContexts).
-->
<Configuration name="ntfy-example-tests" status="warn">
  <Appenders>
    <Console name="CONSOLE" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="warn">
      <AppenderRef ref="CONSOLE"/>
    </Root>
  </Loggers>
</Configuration>
