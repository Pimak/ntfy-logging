<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.pimak</groupId>
        <artifactId>ntfy-logging</artifactId>
        <version>2.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ntfy-example-spring-boot</artifactId>
    <packaging>jar</packaging>

    <name>ntfy-example-spring-boot</name>
    <description>
        Runnable example for ntfy-spring-boot-starter that doubles as its functional test-bed: a
        small Spring Boot application configured via application.yml ntfy.* properties, with an
        injected NtfyClient for manual notifications. The integration tests boot the real
        application against a loopback ntfy stand-in and prove the base alert path, the
        synchronous-vs-asynchronous delivery difference, and the clean-shutdown (context close)
        digest flush. This module is NEVER published to Central.
    </description>

    <properties>
        <!-- Example/test harness, not a released artifact: keep it out of every publish and
             static-analysis path that the released modules run. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <gpg.skip>true</gpg.skip>
        <enforcer.skip>true</enforcer.skip>
        <pmd.skip>true</pmd.skip>
        <cpd.skip>true</cpd.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM scoped to this module (same pattern as ntfy-spring-boot-starter) so
                 its managed versions never collide with the Quarkus BOM elsewhere in the reactor. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The two dependencies a real consumer declares: the Spring Boot starter of their choice
             plus the ntfy starter (which pulls ntfy-core and ntfy-logback transitively). -->
        <dependency>
            <groupId>io.github.pimak</groupId>
            <artifactId>ntfy-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.pimak</groupId>
            <artifactId>ntfy-example-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The *IT integration tests run at verify; version + executions inherited from the
                 parent's pluginManagement — declaring the plugin activates them. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
